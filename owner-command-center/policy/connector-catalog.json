      "discovery": { "source": "configured-endpoint", "resourceFeeds": [{ "kind": "product", "path": "/api/owner/products" }, { "kind": "order", "path": "/api/owner/orders" }, { "kind": "license", "path": "/api/owner/licenses" }] },
      "capabilities": ["monitor", "sync-product", "manage-license", "refund"],
