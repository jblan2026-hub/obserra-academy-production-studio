# Obserra Academy Production Studio
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/obserra_academy_studio?schema=public"

# Runtime
NEXT_PUBLIC_APP_NAME="Obserra Academy Production Studio"
NEXT_PUBLIC_APP_ENV="development"

# Clerk identity and organization authorization
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Owner-only final learner experience review
# Comma-separated Clerk user IDs permitted to conduct final review when an organization owner/admin role is unavailable.
OBSERRA_OWNER_USER_IDS=
# HTTPS origin for the exact staged post-payment learner experience. Do not point this to a script, mockup, or production checkout page.
FINAL_REVIEW_STUDENT_EXPERIENCE_BASE_URL=
# Optional comma-separated origin allowlist. In production the configured learner experience must use HTTPS.
FINAL_REVIEW_ALLOWED_STUDENT_ORIGINS=
FINAL_REVIEW_MINIMUM_QUALITY_SCORE=95
# Optional comma-separated overrides. Defaults require all governed content, media, accessibility, AI, entitlement, and security gates.
FINAL_REVIEW_REQUIRED_ROLES=
FINAL_REVIEW_REQUIRED_QUALITY_CATEGORIES=
# HTTPS origin for the governed course tutor runtime used during owner final review.
FINAL_REVIEW_TUTOR_RUNTIME_BASE_URL=
FINAL_REVIEW_ALLOWED_TUTOR_ORIGINS=
# Optional service credential sent only from the Studio server to the learner tutor runtime.
FINAL_REVIEW_TUTOR_SERVICE_TOKEN=

# Machine to machine authorization for governed automation only
# Send as x-studio-machine-token. Rotate independently from Clerk user sessions.
STUDIO_MACHINE_TOKEN=

# Integration endpoints
ACADEMY_SYNC_URL=
WEBSITE_SYNC_URL=
MARKETPLACE_SYNC_URL=

# AI services
OPENAI_API_KEY=

# Select the default external AI video provider: synthesia or heygen
ACADEMY_VIDEO_PROVIDER=synthesia

# Synthesia
SYNTHESIA_API_KEY=
SYNTHESIA_TEMPLATE_ID=
SYNTHESIA_TEST_MODE=true

# HeyGen
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
