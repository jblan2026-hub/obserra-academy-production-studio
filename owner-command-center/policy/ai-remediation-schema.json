{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obserra.local/schemas/ai-remediation-manifest.json",
  "title": "Obserra Owner AI Approved Remediation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "findingId",
    "title",
    "mappings",
    "severity",
    "ownerApprovalId",
    "approvalDecision",
    "approvedBy",
    "approvedAt",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "target": { "enum": ["website", "studio", "eios"] },
    "findingId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "severity": { "enum": ["medium", "high", "critical"] },
    "knownBad": { "const": true },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(MITRE|OWASP)-" }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "website",
          "academy",
          "commerce",
          "purchase",
          "payment",
          "webhook",
          "identity",
          "certificate",
          "assessment",
          "progress",
          "api",
          "protected-route",
          "deployment",
          "studio",
          "command-center",
          "connector",
          "eios",
          "platform",
          "enterprise",
          "intelligence"
        ]
      }
    },
    "ownerApprovalId": { "type": "string", "minLength": 1 },
    "approvalDecision": { "const": "approved" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "baseBranch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 400 },
          "content": { "type": "string", "maxLength": 1000000 },
          "expectedSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
