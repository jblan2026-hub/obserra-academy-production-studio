FROM node:22-bookworm-slim AS dependencies

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json ./
RUN npm install --ignore-scripts --no-audit --no-fund

FROM dependencies AS builder
WORKDIR /app
COPY . .
# These values are non-secret build placeholders used only because the existing UI
# still compiles Clerk compatibility components. Backend APIs do not depend on them.
ENV DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/academy?schema=public
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZHVtbXktZnJlZS1iYWNrZW5kLWJ1aWxk
ENV CLERK_SECRET_KEY=sk_test_ZHVtbXktZnJlZS1iYWNrZW5kLWJ1aWxk
RUN npx prisma generate
RUN npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/studio ./studio
COPY --from=builder /app/tsconfig.json ./tsconfig.json
COPY --from=builder /app/next-env.d.ts ./next-env.d.ts
RUN npx prisma generate
RUN mkdir -p /app/.academy-private-storage && chown -R node:node /app/.academy-private-storage
USER node
EXPOSE 3000
CMD ["npm", "start"]
