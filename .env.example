# Obserra Academy Production Studio
# Protected Academy Supabase project
SUPABASE_PROJECT_REF="nwxnyqlyzyufgoadtqxs"
SUPABASE_REGION="us-east-1"
SUPABASE_URL="https://nwxnyqlyzyufgoadtqxs.supabase.co"

# GitHub Actions and Prisma should use Supavisor Session Mode (IPv4-compatible, port 5432).
# Replace [DB-PASSWORD] only in a protected local .env or GitHub Actions secret.
# Never commit a populated database URL.
DATABASE_URL="postgresql://postgres.nwxnyqlyzyufgoadtqxs:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connect_timeout=30"

# Runtime
NEXT_PUBLIC_APP_NAME="Obserra Academy Production Studio"
NEXT_PUBLIC_APP_ENV="development"

# -----------------------------------------------------------------------------
# Free-first backend policy
# Core backend operations must work without required paid vendors.
# -----------------------------------------------------------------------------
BACKEND_COST_MODE="free-first"
STUDIO_AUTH_PROVIDER="supabase"
STUDIO_STORAGE_PROVIDER="supabase"
STUDIO_QUEUE_PROVIDER="postgres"
STUDIO_AI_PROVIDER="local"
STUDIO_ALLOW_PAID_AI="false"
STUDIO_PAID_AI_DAILY_CALL_BUDGET="5"
STUDIO_PAID_AI_PER_RUN_CALL_BUDGET="2"

# Supabase Auth JWT verification. Prefer JWKS verification. A JWT secret may be
# supplied only in protected runtime configuration when legacy symmetric signing
# is in use. Do not commit either value.
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_SECRET=
# Single-tenant fallback organization used only when authenticated JWT metadata
# does not include organization_id/org_id.
STUDIO_AUTH_DEFAULT_ORGANIZATION_ID="org_obserra_academy"

# Optional fully self-hosted OIDC identity path. Set STUDIO_AUTH_PROVIDER=oidc.
# The backend discovers jwks_uri from the issuer when STUDIO_OIDC_JWKS_URL is empty.
STUDIO_OIDC_ISSUER=
STUDIO_OIDC_AUDIENCE=
STUDIO_OIDC_JWKS_URL=

# Supabase private object storage for protected Academy backend data.
# Service-role credentials are server-only. Never expose them through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="academy-private"
# Development/self-hosted fallback when STUDIO_STORAGE_PROVIDER=local.
STUDIO_LOCAL_STORAGE_ROOT=".academy-private-storage"

# Local zero-model-cost AI execution. Ollama is the default free inference path.
LOCAL_AI_BASE_URL="http://127.0.0.1:11434"
LOCAL_AI_MODEL="qwen2.5:14b-instruct"
LOCAL_AI_TIMEOUT_MS="300000"
STUDIO_FREE_WORKER_BATCH_SIZE="10"

# Clerk remains an OPTIONAL UI compatibility provider only.
# Backend APIs do not require Clerk when STUDIO_AUTH_PROVIDER=supabase or oidc.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stable owner organization used by protected LCMS loads
STUDIO_OWNER_ORGANIZATION_ID="org_obserra_academy"
STUDIO_OWNER_ORGANIZATION_NAME="Obserra Academy"

# Owner-only final learner experience review
# Comma-separated user IDs permitted to conduct final review when an organization owner/admin role is unavailable.
OBSERRA_OWNER_USER_IDS=
# HTTPS origin for the exact staged post-payment learner experience. Do not point this to a script, mockup, or production checkout page.
FINAL_REVIEW_STUDENT_EXPERIENCE_BASE_URL=
# Optional comma-separated origin allowlist. In production the configured learner experience must use HTTPS.
FINAL_REVIEW_ALLOWED_STUDENT_ORIGINS=
FINAL_REVIEW_MINIMUM_QUALITY_SCORE=95
# Optional comma-separated overrides. Defaults require all governed content, media, accessibility, AI, entitlement, and security gates.
FINAL_REVIEW_REQUIRED_ROLES=
FINAL_REVIEW_REQUIRED_QUALITY_CATEGORIES=
# HTTPS origin for the governed course tutor runtime used during owner final review.
FINAL_REVIEW_TUTOR_RUNTIME_BASE_URL=
FINAL_REVIEW_ALLOWED_TUTOR_ORIGINS=
# Optional service credential sent only from the Studio server to the learner tutor runtime.
FINAL_REVIEW_TUTOR_SERVICE_TOKEN=

# Machine-to-machine authorization for governed automation only.
# Send as x-studio-machine-token. Rotate independently from user sessions.
STUDIO_MACHINE_TOKEN=

# Integration endpoints
ACADEMY_SYNC_URL=
WEBSITE_SYNC_URL=
MARKETPLACE_SYNC_URL=

# Paid model providers are OPTIONAL fallback credentials only. Keep absent when
# running fully free-first. Paid execution must also be explicitly enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External AI video providers are OPTIONAL. Leave unset for script/storyboard/
# local-media production until a paid final-render provider is deliberately used.
ACADEMY_VIDEO_PROVIDER=

# Synthesia optional paid final-render integration
SYNTHESIA_API_KEY=
SYNTHESIA_TEMPLATE_ID=
SYNTHESIA_TEST_MODE=true

# HeyGen optional paid final-render integration
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
