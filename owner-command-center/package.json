{
  "name": "obserra-owner-ai-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Owner-only local AI command center for the Obserra ecosystem.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "verify": "node scripts/verify-local-only.mjs",
    "package:windows": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.obserra.ownercommandcenter",
    "productName": "Obserra Owner AI Command Center",
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
