# Obserra Academy Production Studio
# Protected Academy Supabase project
SUPABASE_PROJECT_REF="nwxnyqlyzyufgoadtqxs"
SUPABASE_REGION="us-east-1"

# GitHub Actions and Prisma should use Supavisor Session Mode (IPv4-compatible, port 5432).
# Replace [DB-PASSWORD] only in a protected local .env or GitHub Actions secret.
# Never commit a populated database URL.
DATABASE_URL="postgresql://postgres.nwxnyqlyzyufgoadtqxs:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connect_timeout=30"

# Runtime
NEXT_PUBLIC_APP_NAME="Obserra Academy Production Studio"
NEXT_PUBLIC_APP_ENV="development"

# Clerk identity and organization authorization
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stable owner organization used by protected LCMS loads
STUDIO_OWNER_ORGANIZATION_ID="org_obserra_academy"
STUDIO_OWNER_ORGANIZATION_NAME="Obserra Academy"

# Machine to machine authorization for governed automation only
# Send as x-studio-machine-token. Rotate independently from Clerk user sessions.
STUDIO_MACHINE_TOKEN=

# Integration endpoints
ACADEMY_SYNC_URL=
WEBSITE_SYNC_URL=
MARKETPLACE_SYNC_URL=

# AI services
OPENAI_API_KEY=

# Select the default external AI video provider: synthesia or heygen
ACADEMY_VIDEO_PROVIDER=synthesia

# Synthesia
SYNTHESIA_API_KEY=
SYNTHESIA_TEMPLATE_ID=
SYNTHESIA_TEST_MODE=true

# HeyGen
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
