generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseStatus {
  IDEA
  RESEARCH
  GENERATING
  REVIEW
  MEDIA
  APPROVAL
  READY
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUIRED
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SourceStatus {
  HEALTHY
  REVIEW_REQUIRED
  OUTDATED
  FAILED
}

enum ReleaseStatus {
  DRAFT
  STAGED
  APPROVED
  PUBLISHED
  ROLLED_BACK
}

enum AiExecutionStatus {
  QUEUED
  ROUTING
  RUNNING
  WAITING_FOR_REVIEW
  SUCCEEDED
  FAILED
  CANCELED
}

enum AiApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUIRED
}

enum AiGuardrailStatus {
  NOT_EVALUATED
  PASSED
  WARNING
  BLOCKED
}

enum AiStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Organization {
  id                  String           @id @default(cuid())
  clerkOrganizationId String           @unique
  name                String
  slug                String           @unique
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  courses             Course[]
  auditEvents         AuditEvent[]
  promptTemplates     AiPromptTemplate[]
  aiExecutions        AiExecution[]
}

model Course {
  id                  String               @id @default(cuid())
  organizationId      String
  slug                String
  title               String
  summary             String?
  status              CourseStatus         @default(IDEA)
  version             Int                  @default(1)
  qualityScore        Int                  @default(0)
  productionOwner     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lessons             Lesson[]
  reviews             CourseReview[]
  qualityAssessments  QualityScore[]
  builds              Build[]
  releases            Release[]
  sourceLinks         CourseSource[]
  expertContributions ExpertContribution[]
  aiExecutions        AiExecution[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([updatedAt])
}

model Lesson {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  position    Int
  objective   String?
  content     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  citations   Citation[]
  assessments Assessment[]
  mediaAssets MediaAsset[]

  @@unique([courseId, position])
  @@index([courseId])
}

model ExpertAgent {
  id              String               @id @default(cuid())
  name            String               @unique
  domain          String
  description     String?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  contributions   ExpertContribution[]
  promptTemplates AiPromptTemplate[]
  executions      AiExecution[]
}

model ExpertContribution {
  id               String      @id @default(cuid())
  courseId         String
  expertId         String
  contributionType String
  payload          Json
  confidence       Float?
  createdAt        DateTime    @default(now())
  course           Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  expert           ExpertAgent @relation(fields: [expertId], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([expertId])
}

model AiModelProfile {
  id                    String        @id @default(cuid())
  key                   String        @unique
  provider              String
  model                 String
  displayName           String
  capabilities          Json
  inputCostPerMillion   Decimal?      @db.Decimal(12, 6)
  outputCostPerMillion  Decimal?      @db.Decimal(12, 6)
  maximumContextTokens  Int?
  supportsStructuredOut Boolean       @default(false)
  supportsTools         Boolean       @default(false)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  executions            AiExecution[]

  @@index([provider, active])
}

model AiPromptTemplate {
  id             String           @id @default(cuid())
  organizationId String
  expertId       String?
  key            String
  name           String
  version        Int
  active         Boolean          @default(true)
  systemPrompt   String
  taskTemplate   String
  outputSchema   Json?
  guardrails     Json?
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expert         ExpertAgent?     @relation(fields: [expertId], references: [id], onDelete: SetNull)
  executions     AiExecution[]

  @@unique([organizationId, key, version])
  @@index([organizationId, active])
  @@index([expertId])
}

model AiExecution {
  id                 String              @id @default(cuid())
  organizationId     String
  courseId           String?
  expertId           String?
  promptTemplateId   String?
  modelProfileId     String?
  requestedBy        String
  objective          String
  status             AiExecutionStatus   @default(QUEUED)
  approvalStatus     AiApprovalStatus     @default(PENDING)
  guardrailStatus    AiGuardrailStatus    @default(NOT_EVALUATED)
  routingReason      String?
  input              Json
  output             Json?
  confidence         Float?
  promptTokens       Int?
  completionTokens   Int?
  estimatedCostUsd   Decimal?             @db.Decimal(14, 6)
  retryCount         Int                  @default(0)
  maxRetries         Int                  @default(2)
  errorCode          String?
  errorMessage       String?
  provenance         Json?
  approvedBy         String?
  approvedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  course             Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  expert             ExpertAgent?         @relation(fields: [expertId], references: [id], onDelete: SetNull)
  promptTemplate     AiPromptTemplate?     @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  modelProfile       AiModelProfile?       @relation(fields: [modelProfileId], references: [id], onDelete: SetNull)
  steps              AiExecutionStep[]

  @@index([organizationId, status, createdAt])
  @@index([courseId])
  @@index([expertId])
  @@index([approvalStatus])
}

model AiExecutionStep {
  id             String         @id @default(cuid())
  executionId    String
  sequence       Int
  name           String
  agentRole      String?
  status         AiStepStatus   @default(PENDING)
  modelProfileKey String?
  input          Json?
  output         Json?
  confidence     Float?
  promptTokens   Int?
  completionTokens Int?
  estimatedCostUsd Decimal?     @db.Decimal(14, 6)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  execution      AiExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([executionId, status])
}

model SourceDocument {
  id              String        @id @default(cuid())
  authority       String
  title           String
  canonicalUrl    String        @unique
  version         String?
  effectiveDate   DateTime?
  status          SourceStatus  @default(HEALTHY)
  contentHash     String?
  lastCollectedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  citations       Citation[]
  courseLinks     CourseSource[]

  @@index([authority])
  @@index([status])
}

model CourseSource {
  id            String         @id @default(cuid())
  courseId      String
  sourceId      String
  applicability String?
  binding       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source        SourceDocument @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([courseId, sourceId])
  @@index([sourceId])
}

model Citation {
  id        String         @id @default(cuid())
  lessonId  String
  sourceId  String
  locator   String?
  quotation String?
  createdAt DateTime       @default(now())
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  source    SourceDocument @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@index([sourceId])
}

model Assessment {
  id        String   @id @default(cuid())
  lessonId  String
  kind      String
  prompt    String
  options   Json?
  answerKey Json?
  rationale String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model MediaAsset {
  id         String   @id @default(cuid())
  lessonId   String?
  type       String
  title      String
  storageKey String
  mimeType   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId])
}

model CourseReview {
  id           String       @id @default(cuid())
  courseId     String
  reviewerRole String
  reviewerId   String?
  status       ReviewStatus @default(PENDING)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
}

model QualityScore {
  id          String   @id @default(cuid())
  courseId    String
  category    String
  score       Int
  threshold   Int
  passed      Boolean
  evidence    Json?
  evaluatedAt DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([passed])
}

model Build {
  id          String      @id @default(cuid())
  courseId    String?
  buildType   String
  status      BuildStatus @default(QUEUED)
  commitSha   String?
  artifactUrl String?
  logs        Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([courseId])
}

model Release {
  id           String        @id @default(cuid())
  courseId     String
  version      String
  status       ReleaseStatus @default(DRAFT)
  packageUrl   String?
  approvedBy   String?
  approvedAt   DateTime?
  publishedAt  DateTime?
  rollbackOfId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, version])
  @@index([status])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  actorId        String?
  actorType      String
  action         String
  resourceType   String
  resourceId     String?
  correlationId  String?
  outcome        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@index([createdAt])
}
