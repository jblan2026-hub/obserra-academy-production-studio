{
  "schemaVersion": "1.0",
  "policyId": "obserra-academy-credential-and-encryption-security",
  "effectiveDate": "2026-08-08",
  "productionStorage": {
    "path": "C:\\ObserraAcademyProduction",
    "fullVolumeEncryptionRequired": true,
    "preferredControl": "BitLocker",
    "recoveryKeyLoggingForbidden": true,
    "recoveryKeyRepositoryStorageForbidden": true,
    "sensitiveOperationsRequireEncryption": true
  },
  "passwords": {
    "applicationPasswordPersistenceForbidden": true,
    "plaintextStorageForbidden": true,
    "reversiblePasswordEncryptionForbidden": true,
    "identityProviderDelegationRequired": true,
    "directPasswordStorageIfEverIntroducedRequiresAdaptiveSaltedKdf": true,
    "approvedKdfExamples": ["Argon2id", "scrypt"],
    "sha256AloneForbiddenForPasswords": true
  },
  "secrets": {
    "encryptionAtRestRequired": true,
    "windowsCredentialBackedEncryptionRequiredForCommandCenter": true,
    "failClosedIfEncryptionUnavailable": true,
    "plaintextSecretPersistenceForbidden": true,
    "secretLoggingForbidden": true,
    "secretRendererExposureForbidden": true,
    "appliesTo": [
      "Stripe secret keys",
      "Clerk secret keys",
      "GitHub tokens",
      "connector credentials",
      "endpoint identity secrets",
      "certificate signing private material",
      "recovery material",
      "API tokens"
    ]
  },
  "integrity": {
    "sha256ApprovedForFileIntegrity": true,
    "sha256ApprovedForFrozenPathLocks": true,
    "sha256ApprovedForArtifactVerification": true,
    "integrityHashesAreNotCredentials": true
  },
  "releaseGate": {
    "blockIfPasswordPersistencePathDetected": true,
    "blockIfPlaintextSecretStorageDetected": true,
    "blockIfReversiblePasswordEncryptionDetected": true,
    "blockIfSha256PasswordHashingDetected": true,
    "blockIfCommandCenterSecretEncryptionUnavailable": true,
    "blockSensitiveOperationsIfProductionVolumeEncryptionNotVerified": true
  }
}
