# Obserra Academy Production Studio
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/obserra_academy_studio?schema=public"

# Runtime
NEXT_PUBLIC_APP_NAME="Obserra Academy Production Studio"
NEXT_PUBLIC_APP_ENV="development"

# Clerk identity and organization authorization
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Machine to machine authorization for governed Studio automation only.
# Send as x-studio-machine-token. Rotate independently from Clerk user sessions.
STUDIO_MACHINE_TOKEN=

# Paid learner delivery authorization.
# Use a separate random value of at least 32 characters in the Studio and Website.
# The Website sends this only from server-side routes as x-academy-delivery-token.
ACADEMY_DELIVERY_TOKEN=

# Supabase private storage. Never expose the service-role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACADEMY_STORAGE_SIGNED_URL_TTL_SECONDS=900

# Release loader ownership context
STUDIO_SEED_CLERK_ORG_ID=
STUDIO_OWNER_ORGANIZATION_ID=
STUDIO_OWNER_ORGANIZATION_NAME="Obserra Academy"

# Integration endpoints
ACADEMY_SYNC_URL=
WEBSITE_SYNC_URL=
MARKETPLACE_SYNC_URL=

# AI services
OPENAI_API_KEY=

# Select the default external AI video provider: synthesia or heygen
ACADEMY_VIDEO_PROVIDER=synthesia

# Synthesia
SYNTHESIA_API_KEY=
SYNTHESIA_TEMPLATE_ID=
SYNTHESIA_TEST_MODE=true

# HeyGen
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
