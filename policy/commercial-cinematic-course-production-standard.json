{
  "schemaVersion": "1.0",
  "standardId": "obserra-commercial-cinematic-course-production-v1",
  "effectiveDate": "2026-08-07",
  "owner": "OBSERRA EXECUTIVE PROTECTION & INTELLIGENCE LLC",
  "qualityTier": "commercial-hollywood-grade",
  "claimBoundary": "Commercial Hollywood-grade is an internal Obserra production quality target. It does not imply affiliation with a film studio, guild, accreditation body, or external certification. The label may be used only after every required technical, editorial, accessibility, rights, security, compliance, and owner-acceptance gate has passed for the exact released assets.",
  "claimPolicy": {
    "qualityClaimAllowedOnlyAfterAcceptance": true,
    "interimLabel": "commercial-cinematic-production-in-progress",
    "prohibitedInterimClaims": [
      "final",
      "mastered",
      "commercial-ready",
      "hollywood-grade",
      "learner-ready",
      "publication-ready"
    ]
  },
  "requiredCourseDeliverables": [
    "approved-creative-treatment",
    "course-production-bible",
    "complete-instructor-manuscript",
    "complete-learner-guide",
    "complete-workbook-and-downloadable-materials",
    "assessment-bank-and-protected-answer-key",
    "certificate-template-and-verification-contract",
    "course-level-source-register",
    "course-level-rights-ledger",
    "commercial-release-evidence-manifest"
  ],
  "requiredInstructionalLessonDeliverables": [
    "learning-objectives",
    "final-narration-script",
    "storyboard",
    "shot-list",
    "scene-and-asset-list",
    "motion-graphics-and-visual-effects-plan",
    "music-and-sound-design-cue-sheet",
    "source-card-plan",
    "mastered-instructional-video",
    "web-delivery-video",
    "human-reviewed-captions",
    "verbatim-transcript",
    "audio-description-or-approved-equivalent",
    "reduced-motion-alternative",
    "lesson-rights-record",
    "technical-quality-control-report",
    "editorial-quality-control-report"
  ],
  "pictureMaster": {
    "minimumRaster": "3840x2160",
    "approvedEquivalentAllowed": true,
    "mezzanineMasterRequired": true,
    "webDeliveryDerivativeRequired": true,
    "consistentFrameRateRequired": true,
    "colorReviewRequired": true,
    "titleSafeReviewRequired": true,
    "motionGraphicsReviewRequired": true,
    "providerPreviewMayNotBeFinal": true,
    "placeholderFramesProhibitedInFinal": true,
    "silentOrStaticMockupMayNotBeFinal": true
  },
  "audioMaster": {
    "sampleRateHz": 48000,
    "minimumBitDepth": 24,
    "integratedLoudnessTargetLufs": -16,
    "integratedLoudnessToleranceLufs": 1,
    "truePeakMaximumDbtp": -1,
    "dialogueIntelligibilityReviewRequired": true,
    "noiseAndArtifactReviewRequired": true,
    "musicAndEffectsRightsRequired": true,
    "noSilentMaster": true,
    "professionalNarrationOrOwnerApprovedEquivalentRequired": true
  },
  "editorialAndVisualQuality": {
    "cinematicOpeningAndClosingRequired": true,
    "visualContinuityReviewRequired": true,
    "pacingAndEngagementReviewRequired": true,
    "brandSystemComplianceRequired": true,
    "sourceCardsRequiredForFactualClaims": true,
    "syntheticOrReenactedSceneLabelsRequiredWhenApplicable": true,
    "visualClarityForInstructionRequired": true,
    "noUnlicensedStockOrGeneratedAsset": true
  },
  "accessibility": {
    "humanReviewedCaptionsRequired": true,
    "verbatimTranscriptRequired": true,
    "audioDescriptionOrApprovedEquivalentRequired": true,
    "reducedMotionAlternativeRequired": true,
    "nonVideoLearningAlternativeRequired": true,
    "keyboardAccessibleMaterialsRequired": true,
    "screenReaderUsableMaterialsRequired": true,
    "colorIndependentMeaningRequired": true
  },
  "rightsAndProvenance": {
    "assetLevelRightsRecordRequired": true,
    "sourceTraceabilityRequired": true,
    "licensedOrOriginalAssetsOnly": true,
    "syntheticMediaDisclosureRequiredWhenApplicable": true,
    "voiceAndLikenessAuthorizationRequired": true,
    "musicLicenseOrOriginalCompositionRequired": true,
    "thirdPartyTrademarkReviewRequired": true,
    "expirationAndTerritoryRestrictionsRecorded": true
  },
  "assessmentQuality": {
    "originalItemsOnly": true,
    "answerKeyProtected": true,
    "rationalesRequired": true,
    "distractorRationalesRequiredWhenApplicable": true,
    "moduleAndObjectiveTraceabilityRequired": true,
    "cognitiveLevelCoverageRequired": true,
    "assessmentIntegrityReviewRequired": true,
    "tutorLockoutDuringGradedAssessmentRequired": true
  },
  "qualityControl": {
    "automatedTechnicalQcRequired": true,
    "humanEditorialQcRequired": true,
    "humanVisualQcRequired": true,
    "humanAudioQcRequired": true,
    "humanAccessibilityQcRequired": true,
    "humanRightsQcRequired": true,
    "securityAndPrivacyQcRequired": true,
    "independentPreOwnerReviewRequired": true,
    "ownerAcceptanceRequired": true,
    "releaseHashesRequired": true,
    "rollbackPackageRequired": true
  },
  "prohibitedFinalSubstitutes": [
    "script-only-package",
    "storyboard-only-package",
    "silent-video",
    "static-slide-export-presented-as-video",
    "provider-test-render",
    "provider-watermarked-preview",
    "unreviewed-ai-output",
    "missing-caption-track",
    "missing-transcript",
    "missing-rights-record",
    "missing-source-traceability",
    "missing-assessment",
    "missing-certificate-package"
  ],
  "requiredReleaseEvidence": [
    "creative-treatment-approval",
    "storyboard-and-shot-list-approval",
    "commercial-video-master-inventory",
    "audio-mastering-report",
    "editorial-color-and-motion-graphics-qc",
    "caption-transcript-and-accessibility-qc",
    "rights-and-provenance-approval",
    "assessment-integrity-approval",
    "learner-materials-approval",
    "certificate-validation",
    "entitlement-and-delivery-validation",
    "security-and-privacy-validation",
    "backup-restore-and-rollback-validation",
    "independent-pre-owner-approval",
    "owner-acceptance"
  ]
}
